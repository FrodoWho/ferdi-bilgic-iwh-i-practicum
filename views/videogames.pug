doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Videogames
        .cards 
            each videogame in data
                .card 
                    h2.card__name #{videogame.properties.name}  
                    p.card__email #{videogame.properties.consoles}
                    p.card__email #{videogame.properties.release_year}